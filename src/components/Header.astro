---
const mainNav = [
  { label: "HOME", href: "/" },
  { label: "Snapchat Planets", href: "/snapchat-planets" },
  { label: "Emojis & Symbols", href: "/emojis-and-symbols" },
  { label: "Latest Blogs", href: "/latest-blogs" },
  { label: "About Us", href: "/about-us" },
  { label: "Contact Us", href: "/contact-us" },
];

const secondaryNav = [
  { label: "DMCA Policy", href: "/dmca-policy" },
  { label: "Terms and Conditions", href: "/terms-and-conditions" },
  { label: "Disclaimer", href: "/disclaimer" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="header">
  <div class="header-top">
    <a href="/" class="logo">🪐 SnapchatPlanet</a>
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <nav class="nav" id="main-nav" aria-label="Main navigation">
    <ul class="nav-row nav-row--main">
      {
        mainNav.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={["nav-link", { active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="nav-row nav-row--secondary">
      {
        secondaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={["nav-link nav-link--sm", { active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("main-nav");

  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("nav-open");
    toggle.classList.toggle("open", open ?? false);
    toggle.setAttribute("aria-expanded", String(open));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav?.classList.remove("nav-open");
      toggle?.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(17, 24, 39, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-top {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--snap-yellow);
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.5rem;
    cursor: pointer;
  }

  .bar {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--snap-yellow);
    transition: transform 0.3s, opacity 0.3s;
  }

  .menu-toggle.open .bar:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.open .bar:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.25rem 0.75rem;
    display: none;
  }

  .nav-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .nav-row--secondary {
    margin-top: 0.375rem;
    padding-top: 0.375rem;
    border-top: 1px solid var(--border);
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 0.375rem;
    transition: color 0.2s, background 0.2s;
  }

  .nav-link--sm {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--snap-yellow);
    background: rgba(255, 252, 0, 0.08);
    text-decoration: none;
  }

  .nav-open {
    display: block;
    position: fixed;
    inset: 0;
    top: 3.5rem;
    background: rgba(10, 14, 26, 0.98);
    padding: 1.5rem;
    overflow-y: auto;
  }

  .nav-open .nav-row {
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }

    .nav {
      display: block;
      padding-bottom: 0.625rem;
    }
  }
</style>

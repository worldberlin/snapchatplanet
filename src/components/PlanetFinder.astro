---
import { planets } from "../data/planets";

const planetData = planets.map((p) => ({
  slug: p.slug,
  name: p.name,
  rank: p.rank,
  emoji: p.emoji,
  hearts: p.hearts,
  color: p.color,
  description: p.fullDescription.split(". ").slice(0, 2).join(". ") + ".",
}));
---

<section class="finder-section" id="planet-finder" aria-labelledby="finder-heading">
  <div class="finder-wrapper">
    <div class="phone-frame">
      <div class="phone-notch" aria-hidden="true"></div>
      <div class="phone-screen">
        <h2 id="finder-heading" class="finder-title">Find Your Snapchat Planet</h2>

        <div class="dropdown-container">
          <button
            type="button"
            class="dropdown-trigger"
            id="dropdown-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span id="dropdown-label">Tap to choose your planet...</span>
            <span class="dropdown-chevron" aria-hidden="true">▲</span>
          </button>

          <ul
            class="dropdown-list"
            id="dropdown-list"
            role="listbox"
            hidden
          >
            {
              planets.map((planet) => (
                <li
                  role="option"
                  class="dropdown-option"
                  data-slug={planet.slug}
                  tabindex="-1"
                >
                  <span class="option-emoji">{planet.emoji}</span>
                  <span>
                    {planet.name} — Rank #{planet.rank}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="result-panel" id="result-panel" hidden>
          <div class="result-emoji" id="result-emoji"></div>
          <h3 class="result-name" id="result-name"></h3>
          <span class="result-badge" id="result-badge"></span>
          <p class="result-desc" id="result-desc"></p>
          <p class="result-hearts" id="result-hearts"></p>
          <button type="button" class="btn btn-primary btn-sm" id="share-btn">
            Share Result
          </button>
          <p class="share-toast" id="share-toast" hidden>Copied to clipboard!</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ planetData }}>
  const trigger = document.getElementById("dropdown-trigger");
  const list = document.getElementById("dropdown-list");
  const label = document.getElementById("dropdown-label");
  const panel = document.getElementById("result-panel");
  const resultEmoji = document.getElementById("result-emoji");
  const resultName = document.getElementById("result-name");
  const resultBadge = document.getElementById("result-badge");
  const resultDesc = document.getElementById("result-desc");
  const resultHearts = document.getElementById("result-hearts");
  const shareBtn = document.getElementById("share-btn");
  const shareToast = document.getElementById("share-toast");

  let selected = null;

  function closeDropdown() {
    list.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
  }

  function openDropdown() {
    list.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
  }

  function showResult(planet) {
    selected = planet;
    panel.hidden = false;
    resultEmoji.textContent = planet.emoji;
    resultName.textContent = planet.name;
    resultBadge.textContent = `RANK #${planet.rank}`;
    resultDesc.textContent = planet.description;
    resultHearts.textContent = planet.hearts;
    label.textContent = `${planet.emoji} ${planet.name}`;
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (list.hidden) openDropdown();
    else closeDropdown();
  });

  list?.querySelectorAll(".dropdown-option").forEach((option) => {
    option.addEventListener("click", () => {
      const slug = option.dataset.slug;
      const planet = planetData.find((p) => p.slug === slug);
      if (planet) showResult(planet);
      closeDropdown();
    });
  });

  document.addEventListener("click", () => closeDropdown());

  shareBtn?.addEventListener("click", async () => {
    if (!selected) return;
    const text = `My Snapchat Planet is ${selected.name} (Rank #${selected.rank})! ${selected.hearts} — Find yours at snapchatplanet-six.vercel.app`;
    try {
      await navigator.clipboard.writeText(text);
      shareToast.hidden = false;
      setTimeout(() => {
        shareToast.hidden = true;
      }, 2500);
    } catch {
      shareToast.textContent = "Could not copy — try again";
      shareToast.hidden = false;
    }
  });
</script>

<style>
  .finder-section {
    padding: 2rem 1.25rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  .finder-wrapper {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: min(100%, 22rem);
    background: var(--snap-yellow);
    border-radius: 2.5rem;
    padding: 0.75rem;
    box-shadow:
      0 0 0 4px rgba(255, 252, 0, 0.2),
      0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .phone-notch {
    width: 5rem;
    height: 0.375rem;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 999px;
    margin: 0.25rem auto 0.75rem;
  }

  .phone-screen {
    background: #000;
    border-radius: 2rem;
    padding: 1.5rem 1.25rem 2rem;
    min-height: 24rem;
    position: relative;
  }

  .finder-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .dropdown-container {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .dropdown-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    text-align: left;
  }

  .dropdown-chevron {
    color: var(--snap-yellow);
    font-size: 0.625rem;
    flex-shrink: 0;
  }

  .dropdown-list {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    list-style: none;
    margin: 0;
    padding: 0.375rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.5);
    max-height: 14rem;
    overflow-y: auto;
    z-index: 10;
  }

  .dropdown-list[hidden] {
    display: none;
  }

  .dropdown-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.5rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .dropdown-option:hover {
    background: #3b82f6;
    color: #fff;
  }

  .option-emoji {
    font-size: 1.25rem;
  }

  .result-panel {
    text-align: center;
    animation: fadeUp 0.35s ease;
  }

  .result-panel[hidden] {
    display: none;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-emoji {
    font-size: 4rem;
    line-height: 1;
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 0 16px rgba(255, 252, 0, 0.3));
  }

  .result-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.5rem;
  }

  .result-badge {
    display: inline-block;
    background: var(--snap-yellow);
    color: #000;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.875rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .result-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .result-hearts {
    font-size: 1.5rem;
    margin: 0 0 1.25rem;
    letter-spacing: 0.25rem;
  }

  .share-toast {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--snap-yellow);
  }
</style>

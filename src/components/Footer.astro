---
const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Snapchat Planets", href: "/snapchat-planets" },
  { label: "Emojis & Symbols", href: "/emojis-and-symbols" },
  { label: "Latest Blogs", href: "/latest-blogs" },
  { label: "About Us", href: "/about-us" },
  { label: "Contact Us", href: "/contact-us" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "DMCA Policy", href: "/dmca-policy" },
  { label: "Terms and Conditions", href: "/terms-and-conditions" },
  { label: "Disclaimer", href: "/disclaimer" },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">🪐 SnapchatPlanet</a>
      <p class="footer-tagline">
        Your independent guide to Snapchat Planets, the Best Friends Solar System,
        friendship emojis, and everything you need to decode your Snapchat universe.
      </p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <h3 class="footer-nav-title">Quick Links</h3>
      <ul>
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="footer-bottom">
    <p class="disclaimer">Not affiliated with Snap Inc.</p>
    <p>&copy; 2026 SnapchatPlanet. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    padding: 3rem 1.25rem 1.5rem;
    margin-top: 2rem;
  }

  .footer-inner {
    max-width: 72rem;
    margin: 0 auto 2rem;
    display: grid;
    gap: 2rem;
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .footer-logo:hover {
    color: var(--snap-yellow);
    text-decoration: none;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 28rem;
    margin: 0;
  }

  .footer-nav-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
  }

  .footer-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .footer-nav a:hover {
    color: var(--snap-yellow);
  }

  .footer-bottom {
    max-width: 72rem;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .disclaimer {
    font-weight: 600;
    color: var(--text-primary) !important;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.5fr 1fr;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>

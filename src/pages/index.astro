---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanetFinder from "../components/PlanetFinder.astro";
import { planets } from "../data/planets";
---

<BaseLayout
  title="Snapchat Planets: Complete Guide to Best Friends Solar System"
  description="Snapchat planets explained — learn what each planet means, find your best friend rank from Mercury to Neptune, and master the Snapchat solar system."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-orbit-ring" aria-hidden="true"></div>
    <div class="hero-content">
      <span class="hero-badge">✨ Snapchat Solar System Guide</span>
      <h1>Snapchat Planets: Complete Guide to Best Friends Solar System</h1>
      <p class="hero-lead">
        Ever wondered what planet you are in someone's Snapchat universe? Discover
        how the <strong>snapchat planets</strong> system ranks your friendships
        from Mercury to Neptune — and use our interactive tool to decode every
        orbit.
      </p>
      <div class="hero-actions">
        <a href="#planet-finder" class="btn btn-primary">Find Your Planet</a>
        <a href="/snapchat-planets" class="btn btn-outline">Explore All Planets</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="solar-system">
        <div class="sun"></div>
        {
          planets.map((planet, i) => (
            <div
              class="orbit"
              style={`--orbit-size: ${(i + 1) * 2.75}rem; --duration: ${12 + i * 3}s; --delay: ${-i * 1.5}s`}
            >
              <div
                class="mini-planet"
                style={`--planet-color: ${planet.color}`}
                title={planet.name}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Planet Finder Tool -->
  <section class="section">
    <PlanetFinder />
  </section>

  <!-- Quick Overview -->
  <section class="section overview">
    <div class="section-inner">
      <h2 class="section-title">How Snapchat Planets Work</h2>
      <p class="section-lead">
        Snapchat assigns each of your top eight best friends a planet in a solar
        system orbiting around you. The closer the planet to the Sun, the higher
        the friendship rank.
      </p>
      <div class="planet-grid">
        {
          planets.map((planet) => (
            <article class="planet-card">
              <div
                class="planet-card-icon"
                style={`--planet-color: ${planet.color}`}
              >
                {planet.emoji}
              </div>
              <div class="planet-card-body">
                <span class="planet-card-rank">#{planet.rank}</span>
                <h3>{planet.name}</h3>
                <p>{planet.meaning}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="cta-card">
      <h2>Ready to Decode Your Solar System?</h2>
      <p>
        Learn what each emoji, symbol, and planet position means — and never
        wonder about your Snapchat best friend rank again.
      </p>
      <a href="#planet-finder" class="btn btn-primary">Use the Planet Finder</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 3rem 1.25rem 4rem;
    overflow: hidden;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
  }

  .hero-glow {
    position: absolute;
    top: -4rem;
    left: 50%;
    transform: translateX(-50%);
    width: 30rem;
    height: 30rem;
    background: radial-gradient(circle, rgba(255, 252, 0, 0.08) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-orbit-ring {
    position: absolute;
    top: 50%;
    right: -5rem;
    width: 20rem;
    height: 20rem;
    border: 1px solid rgba(255, 252, 0, 0.06);
    border-radius: 50%;
    pointer-events: none;
    display: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255, 252, 0, 0.1);
    border: 1px solid rgba(255, 252, 0, 0.25);
    color: var(--snap-yellow);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.375rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    background: linear-gradient(135deg, #fff 30%, var(--snap-yellow) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-lead {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }

  .hero-lead strong {
    color: var(--snap-yellow);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  /* Solar system animation */
  .hero-visual {
    display: flex;
    justify-content: center;
    padding: 1rem 0;
  }

  .solar-system {
    position: relative;
    width: 16rem;
    height: 16rem;
  }

  .sun {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.5rem;
    height: 2.5rem;
    background: radial-gradient(circle at 40% 40%, #fff9a0, var(--snap-yellow));
    border-radius: 50%;
    box-shadow:
      0 0 20px rgba(255, 252, 0, 0.6),
      0 0 60px rgba(255, 252, 0, 0.3);
    z-index: 2;
  }

  .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--orbit-size);
    height: var(--orbit-size);
    margin-top: calc(var(--orbit-size) / -2);
    margin-left: calc(var(--orbit-size) / -2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 50%;
    animation: spin var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  .mini-planet {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 0.5rem;
    height: 0.5rem;
    background: var(--planet-color);
    border-radius: 50%;
    box-shadow: 0 0 6px color-mix(in srgb, var(--planet-color) 60%, transparent);
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Sections */
  .section {
    padding: 1rem 1.25rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  .section-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .section-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    text-align: center;
    margin: 0 0 0.75rem;
    color: #fff;
  }

  .section-lead {
    text-align: center;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  /* Planet grid */
  .planet-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .planet-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .planet-card:hover {
    border-color: rgba(255, 252, 0, 0.2);
    transform: translateX(4px);
  }

  .planet-card-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 35%,
      color-mix(in srgb, var(--planet-color) 70%, white),
      var(--planet-color)
    );
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    flex-shrink: 0;
    box-shadow: 0 0 12px color-mix(in srgb, var(--planet-color) 40%, transparent);
  }

  .planet-card-body {
    min-width: 0;
  }

  .planet-card-rank {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--snap-yellow);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .planet-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0.125rem 0;
    color: #fff;
  }

  .planet-card p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* CTA */
  .cta-section {
    padding-bottom: 4rem;
  }

  .cta-card {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: linear-gradient(135deg, rgba(255, 252, 0, 0.06) 0%, rgba(255, 252, 0, 0.02) 100%);
    border: 1px solid rgba(255, 252, 0, 0.15);
    border-radius: 1.25rem;
    max-width: 40rem;
    margin: 0 auto;
  }

  .cta-card h2 {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: #fff;
  }

  .cta-card p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  @media (min-width: 640px) {
    .planet-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 4rem 2rem 5rem;
      text-align: left;
    }

    .hero-content {
      text-align: left;
    }

    .hero-lead {
      margin-left: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .hero-orbit-ring {
      display: block;
    }

    .solar-system {
      width: 20rem;
      height: 20rem;
    }
  }

  @media (min-width: 1024px) {
    .planet-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<BaseLayout
  title="Privacy Policy — SnapchatPlanet"
  description="SnapchatPlanet privacy policy. Learn how we handle your data when you visit our Snapchat Planets guide website."
  canonicalPath="/privacy-policy"
>
  <section class="section">
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Privacy Policy" },
      ]}
    />

    <h1>Privacy Policy</h1>

    <div class="prose page-content">
      <p><em>Last updated: January 2024</em></p>

      <p>
        SnapchatPlanet ("we," "us," or "our") operates the website at snapchatplanet-six.vercel.app.
        This Privacy Policy explains how we collect, use, and protect information when you visit our
        site. We are an independent information resource about
        <a href="/snapchat-planets">Snapchat Planets</a> and are not affiliated with Snap Inc.
      </p>

      <h2>Information We Collect</h2>
      <p>
        We may collect anonymous usage data through standard web analytics tools, including pages
        visited, browser type, device type, and referring URLs. If you submit our
        <a href="/contact-us">contact form</a>, we collect the name, email address, and message you
        provide voluntarily.
      </p>

      <h2>How We Use Information</h2>
      <p>
        We use collected information to improve our content, respond to inquiries, and understand
        how visitors use our Snapchat Planets guides. We do not sell personal information to third
        parties.
      </p>

      <h2>Cookies</h2>
      <p>
        Our website may use cookies and similar technologies for analytics and site functionality.
        You can control cookie preferences through your browser settings.
      </p>

      <h2>Third-Party Links</h2>
      <p>
        Our site contains links to external websites including Snapchat.com. We are not responsible
        for the privacy practices of third-party sites. Please review their policies separately.
      </p>

      <h2>Contact</h2>
      <p>
        For privacy-related questions, visit our <a href="/contact-us">Contact Us</a> page or return
        to the <a href="/">Snapchat Planets homepage</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 700; margin: 0 0 1.5rem; }
  .page-content { max-width: 48rem; }
</style>
